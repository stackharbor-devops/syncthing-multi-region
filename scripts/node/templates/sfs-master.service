[Unit]
Description=SeaweedFS master (sfs)
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sfs/node.env

[Service]
Type=simple
WorkingDirectory=/etc/sfs
ExecStart=/usr/local/sbin/sfs-node run master
Restart=always
RestartSec=5
LimitNOFILE=1048576
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
