[Unit]
Description=sfsctl - SeaweedFS platform control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=/opt/sfsctl
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/opt/sfsctl
ExecStart=/usr/bin/python3 -m sfsctl.server --config /etc/sfsctl/config.json
Restart=always
RestartSec=3
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
